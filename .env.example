# Copy to .env and fill the cloud credentials. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=case-documents
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Base64 of the public JWKS JSON for offline token verification inside Docker.
SUPABASE_JWKS_B64=
# Retained for optional hosted migration; default app uses local PostgreSQL.
SUPABASE_DB_URL=
# Set only after the hosted migration succeeds and TCP access works.
CASEWISE_ACTIVE_DB_URL=
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-2.5-flash
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
